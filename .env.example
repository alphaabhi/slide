# Copy to .env.local for local development. Never commit real values.
# Only VITE_-prefixed, browser-safe values belong here.

# Supabase project URL (Settings → API → Project URL)
VITE_SUPABASE_URL=
# Supabase anon/public key (Settings → API). Safe for the browser; RLS protects data.
VITE_SUPABASE_ANON_KEY=
# Show /styleguide outside dev (e.g. on Vercel previews). Leave false in production.
VITE_ENABLE_STYLEGUIDE=false

# NEVER put the service_role key or database password in this file or in Vercel
# variables prefixed with VITE_.
